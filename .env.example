# --- LLM (pick one provider) ---
LLM_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Embeddings ---
EMBEDDING_PROVIDER=openai         # openai | stub (stub = deterministic, for tests/dev)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Reranker (optional) ---
COHERE_API_KEY=                   # free tier; empty = skip reranking

# --- CORS (production: set to your frontend origin) ---
ALLOWED_ORIGINS=*

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rfp

# --- Organization profile (who the proposals are written for) ---
# cp profile.example.json profile.json, then edit it.
ORG_PROFILE_PATH=profile.json

# --- Tuning ---
CHUNK_MAX_TOKENS=900
RETRIEVAL_TOP_K=8
